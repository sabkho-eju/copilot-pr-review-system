      "name": "github_get_pr",
      "description": "Fetch the metadata of a pull request (title, body, branches, stats).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "pr_number": {
            "type": "number",
            "description": "Pull request number."
          }
        },
        "required": [
          "owner",
          "repo",
          "pr_number"
        ]
      }
    },
